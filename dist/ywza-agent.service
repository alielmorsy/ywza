# Linux: agent on the login screen and in every X11 user session. Edit the path, then:
#   sudo cp dist/ywza-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ywza-agent
# gdm also needs an X11 login screen: WaylandEnable=false under [daemon] in /etc/gdm3/daemon.conf.
[Unit]
Description=ywza agent (login screen and user sessions)
After=systemd-logind.service display-manager.service

[Service]
# To keep an identity from a per-user install, add --user <name> once (copied to /var/lib/ywza).
ExecStart=/home/cadence/ywza/target/release/ywza-agent service
Restart=always
# Keep apps the agent launched alive across service restarts.
KillMode=process

[Install]
WantedBy=graphical.target
