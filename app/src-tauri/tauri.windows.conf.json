{
  "build": {
    "beforeBundleCommand": "cargo build --release -p ywza-agent -p ywza-cli"
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "../../plugin/server/run.py": "mcp/run.py",
      "../../plugin/server/ywza_mcp/*.py": "mcp/ywza_mcp/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
